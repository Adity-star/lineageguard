# LineageGuard Environment Variables for Docker

# Node Environment
NODE_ENV=production
LOG_LEVEL=info

# Anthropic API Key (for LLM generation)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

GROK_API_KEY=xxx
# DataHub Configuration
DATAHUB_GMS_URL=http://datahub:8080
DATAHUB_GMS_TOKEN=your_datahub_token_here

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_owner
GITHUB_REPOSITORY=your_github_repository
GITHUB_BASE_BRANCH=main

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://lineageguard:lineageguard@postgres:5432/lineageguard

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
