# LineageGuard Environment Variables

# ====================
# Application
# ====================
NODE_ENV=production
LOG_LEVEL=info

# ====================
# Grok LLM Configuration
# ====================
GROK_API_KEY=your_groq_api_key_here
GROK_MODEL=llama-3.3-70b-versatile
GROK_BASE_URL=https://api.groq.com/openai/v1

# ====================
# DataHub Configuration
# ====================
# DataHub GMS URL (for Docker use: http://datahub-gms:8080)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=your_datahub_token_here

# Enable/disable DataHub mutation tools (writeback)
TOOLS_IS_MUTATION_ENABLED=true

# ====================
# GitHub Configuration
# ====================
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPOSITORY=your_repository_name
GITHUB_BASE_BRANCH=main

# ====================
# PostgreSQL Configuration
# ====================
# For Docker use: postgresql://lineageguard:lineageguard@postgres:5432/lineageguard
DATABASE_URL=postgresql://lineageguard:lineageguard@localhost:5432/lineageguard

# ====================
# Idempotency Configuration
# ====================
IDEMPOTENCY_CLEANUP_INTERVAL_MS=300000
IDEMPOTENCY_RETENTION_BUFFER_HOURS=1
IDEMPOTENCY_PENDING_TIMEOUT_MINUTES=10