// LineageGuard Database Schema
// AI-powered Schema Change Governance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Core Entities
// ============================================================================

/// User accounts and authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role      @default(DEVELOPER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships    Membership[]
  approvals      ApprovalDecision[]
  auditLogs      AuditLog[]
  changeRequests ChangeRequest[]
  
  @@index([email])
  @@index([role])
}

/// Role-based access control
enum Role {
  ADMIN
  DEVELOPER
  REVIEWER
  VIEWER
}

/// Tenant for multi-tenancy
model Tenant {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  plan          Plan      @default(FREE)
  status         TenantStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships    Membership[]
  changeRequests ChangeRequest[]
  workflows     WorkflowRun[]
  auditLogs      AuditLog[]

  @@index([slug])
  @@index([status])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// User membership in a tenant
model Membership {
  id            String    @id @default(cuid())
  userId        String
  tenantId      String
  role          Role      @default(DEVELOPER)
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([status])
}

enum MembershipStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

// ============================================================================
// Change Requests
// ============================================================================

/// Schema change request submitted by users
model ChangeRequest {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  description   String
  datasetUrn    String?
  priority      Priority  @default(MEDIUM)
  status        RequestStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows     WorkflowRun[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  REJECTED
  FAILED
}

// ============================================================================
// Workflow Execution
// ============================================================================

/// Complete workflow run for a change request
model WorkflowRun {
  id                String    @id @default(cuid())
  changeRequestId   String
  tenantId          String
  status            WorkflowStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  version           Int       @default(1)
  idempotencyKey    String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  changeRequest     ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps             ExecutionStep[]
  state             WorkflowState?
  approval          ApprovalDecision?
  riskAssessment    RiskAssessment?
  impactReport      ImpactReport?
  artifacts         GeneratedArtifact[]
  metrics           PipelineMetrics?

  @@index([changeRequestId])
  @@index([tenantId])
  @@index([status])
  @@index([startedAt])
  @@index([version])
  @@index([idempotencyKey])
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Individual step execution in the workflow
model ExecutionStep {
  id                String    @id @default(cuid())
  workflowRunId     String
  stage             PipelineStage
  status            StepStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  errorMessage      String?
  output            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([stage])
  @@index([status])
  @@index([startedAt])
}

enum PipelineStage {
  CONTEXT
  PLANNING
  RISK
  GENERATION
  IMPACT
  APPROVAL
  GITHUB
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// Complete workflow state snapshot
model WorkflowState {
  id                String    @id @default(cuid())
  workflowRunId     String    @unique
  request           Json
  context           Json?
  plan              Json?
  risk              Json?
  generation        Json?
  impact            Json?
  approval          Json?
  github            Json?
  performance       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
}

// ============================================================================
// Assessments
// ============================================================================

/// Risk assessment for a change request
model RiskAssessment {
  id                String    @id @default(cuid())
  workflowRunId     String    @unique
  overallRisk       RiskLevel
  score             Int
  affectedAssets    Json
  findings          Json
  recommendations    Json
  requiresApproval  Boolean
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([overallRisk])
  @@index([score])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Impact analysis report
model ImpactReport {
  id                String    @id @default(cuid())
  workflowRunId     String    @unique
  summary           String
  score             Int
  level             RiskLevel
  requiresApproval  Boolean
  affectedColumns   Json
  affectedAssets    Json
  recommendations    Json
  triggeredRules    Json?
  generatedAt       DateTime  @default(now())
  metadata          Json

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([level])
  @@index([score])
}

// ============================================================================
// Approval
// ============================================================================

/// Approval decision for a change request
model ApprovalDecision {
  id                String    @id @default(cuid())
  workflowRunId     String    @unique
  userId            String
  status            ApprovalStatus
  reason            String?
  reviewedAt        DateTime  @default(now())
  idempotencyKey    String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([userId])
  @@index([status])
  @@index([reviewedAt])
  @@index([idempotencyKey])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// Generated Artifacts
// ============================================================================

/// Generated artifacts (SQL, Prisma schema, documentation, etc.)
model GeneratedArtifact {
  id                String    @id @default(cuid())
  workflowRunId     String
  artifactType      ArtifactType
  content           String    @db.Text
  filename          String?
  checksum          String?
  size              Int?
  idempotencyKey    String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([artifactType])
  @@index([createdAt])
  @@index([idempotencyKey])
}

enum ArtifactType {
  PRISMA_SCHEMA
  SQL_MIGRATION
  ROLLBACK_SQL
  DOCUMENTATION
  DBT_FILES
  GITHUB_PR
}

// ============================================================================
// Performance Metrics
// ============================================================================

/// Pipeline performance metrics
model PipelineMetrics {
  id                String    @id @default(cuid())
  workflowRunId     String    @unique
  contextMs         Int?
  planningMs        Int?
  riskMs            Int?
  generationMs      Int?
  impactMs          Int?
  approvalMs        Int?
  githubMs          Int?
  totalMs           Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workflowRun       WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
}

// ============================================================================
// Audit & Logging
// ============================================================================

/// Comprehensive audit log for all operations
model AuditLog {
  id                String    @id @default(cuid())
  tenantId          String?
  userId            String?
  entityType        EntityType
  entityId          String
  action            AuditAction
  details           Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  // Relations
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum EntityType {
  USER
  TENANT
  CHANGE_REQUEST
  WORKFLOW_RUN
  APPROVAL_DECISION
  RISK_ASSESSMENT
  IMPACT_REPORT
  GENERATED_ARTIFACT
  RATE_LIMIT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  START
  COMPLETE
  FAIL
  CANCEL
  RATE_LIMIT_EXCEEDED
}

// ============================================================================
// Idempotency
// ============================================================================

/// Status of an idempotency slot
enum IdempotencyStatus {
  PENDING    // Slot claimed; external operation not yet complete
  COMPLETED  // Operation succeeded; result is cached
  FAILED     // Operation failed; slot released for retry
}

/// Central idempotency record — replaces all in-memory Map() state
/// Composite unique key (operationType, tenantId, key) is the atomic race guard
model IdempotencyRecord {
  id            String            @id @default(cuid())
  key           String
  operationType String
  tenantId      String?
  entityId      String?           // Hint FK to the created entity
  result        Json?             // Cached stage output payload
  status        IdempotencyStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([operationType, tenantId, key])
  @@index([operationType, tenantId, key])
  @@index([expiresAt])
  @@index([status])
}
