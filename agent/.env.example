#######################################
# Groq
#######################################

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

#######################################
# DataHub
#######################################

# DataHub GMS endpoint - used by STDIO transport as env vars passed to mcp-server-datahub
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Enable write-back: add_tags, update_description, add_structured_properties etc.
# Set to false to run the agent in read-only mode.
TOOLS_IS_MUTATION_ENABLED=true

# HTTP transport (legacy, not used when STDIO is active)
# DATAHUB_MCP_URL=http://localhost:8080
# DATAHUB_MCP_TOKEN=

#######################################
# GitHub
#######################################

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main

#######################################
# Prisma
#######################################

DATABASE_URL=

#######################################
# Application
#######################################

NODE_ENV=development
LOG_LEVEL=info

#######################################
# Idempotency
#######################################
IDEMPOTENCY_CLEANUP_INTERVAL_MS=300000
IDEMPOTENCY_RETENTION_BUFFER_HOURS=1
IDEMPOTENCY_PENDING_TIMEOUT_MINUTES=10